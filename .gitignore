# Binaries and build output
/authstunt
/dist/
web/dist/
node_modules/
# npm package build output: only sources, configs and lockfiles under
# packages/ are tracked; dist is rebuilt from them and never committed.
packages/*/dist/
*.tsbuildinfo
# Playwright writes its run artifacts next to the suite. They are outputs of
# a run, never inputs to one, so no run depends on a committed copy.
packages/playwright/test-results/
packages/playwright/playwright-report/
packages/playwright/blob-report/

# Data and secrets
*.db
*.db-wal
*.db-shm
.authstunt/
*.key
.env
.env.*

# OS, editor and tooling noise
.DS_Store
.claude/

# The repo root publishes the documents listed below and nothing else. Any
# other note that lands there stays local, so working material cannot reach
# this history by accident.
/*.md
!/README.md
!/CLAUDE.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/CHANGELOG.md

# Local working notes
plans/
